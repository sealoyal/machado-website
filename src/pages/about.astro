---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About"
	description="Australian Solar Care cleans solar panels for residential and commercial customers."
>
	<section class="mx-auto max-w-3xl px-5 py-16">
		<p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">About</p>
		<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
			A company for clean solar panels
		</h1>
		<div class="content mt-6 text-lg">
			<p>
				Australian Solar Care cleans solar panels. The work is for homes and for commercial sites: the glass is cleaned, rinsed, and left clear.
			</p>
			<p>
				Service area, phone, and email are still to be confirmed: [Service area], [Phone], [Email].
			</p>
			<p>Licences and insurance: [to be confirmed].</p>
		</div>
	</section>
</BaseLayout>
