---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Placeholder from '../components/Placeholder.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Testimonials from '../components/Testimonials.astro';
import hero from '../assets/hero-commercial-cleaning.jpg';
import { services, site } from '../data/site';
---

<BaseLayout title={site.name} description={site.description}>
	<section class="relative isolate overflow-hidden bg-navy text-white">
		<Image
			src={hero}
			alt=""
			width={1024}
			height={682}
			layout="none"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 -z-10 h-full w-full object-cover"
		/>
		<div class="absolute inset-0 -z-10 bg-navy/55 md:bg-transparent md:bg-gradient-to-r md:from-navy/90 md:via-navy/55 md:to-navy/20" aria-hidden="true"></div>
		<div class="mx-auto max-w-5xl px-5 py-20 md:py-28">
			<div class="max-w-xl">
				<p class="text-sm font-semibold uppercase tracking-[0.14em] text-sun">
					Solar panel cleaning, Adelaide, South Australia
				</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance text-white md:text-5xl">
					Solar panel cleaning and maintenance in Adelaide and South Australia
				</h1>
				<p class="mt-4 text-lg text-white/80">Approved installer for bird and pest proofing systems</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/contact" class="rounded-full bg-white px-5 py-3 text-sm font-semibold text-navy focus-visible:outline-white">
						Get a quote
					</a>
					<a href={site.phoneHref} class="inline-flex items-center gap-2 rounded-full border border-white/40 px-5 py-3 text-sm font-semibold text-white focus-visible:outline-white">
						<Icon name="phone" />
						Call us
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">Solar panels are not self-cleaning</h2>
		<p class="mt-4 leading-7 text-muted">
			For years, many manufacturers claimed solar panels were self-cleaning. But research – and real-world experience – prove otherwise. While they are low-maintenance, they are definitely not maintenance-free.
		</p>
	</section>

	<section class="border-t border-line bg-accent-soft">
		<div class="mx-auto max-w-5xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">Our service</h2>
			<div class="mt-8 grid gap-4 md:grid-cols-3">
				{
					services.slice(0, 3).map((service) => (
						<article class="flex h-full flex-col rounded-2xl border border-line bg-white p-6">
							<Placeholder label={`${service.title} image placeholder`} />
							<h3 class="mt-5 text-2xl font-semibold tracking-tight">
								<a href={service.href}>{service.title}</a>
							</h3>
							<p class="mt-3 flex-1 leading-7 text-muted">{service.summary}</p>
							<a href={service.href} class="mt-5 text-sm font-semibold text-accent">Learn more</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">Why choose Australian Solar Care?</h2>
		<div class="mt-8 grid gap-4 md:grid-cols-3">
			<article class="rounded-2xl border border-line p-6">
				<h3 class="font-semibold">Solar system health check</h3>
				<p class="mt-2 leading-7 text-muted">Visual inspection to identify issues and potential risks.</p>
			</article>
			<article class="rounded-2xl border border-line p-6">
				<h3 class="font-semibold">Fully insured – $20M public liability</h3>
				<p class="mt-2 leading-7 text-muted">Insurance coverage for peace of mind.</p>
			</article>
			<article class="rounded-2xl border border-line p-6">
				<h3 class="font-semibold">Qualified solar technicians</h3>
				<p class="mt-2 leading-7 text-muted">Trained, insured and safety-focused professionals.</p>
			</article>
		</div>
	</section>

	<section class="border-t border-line bg-navy text-white">
		<div class="mx-auto max-w-5xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">Proven results</h2>
			<p class="mt-4 max-w-2xl leading-7 text-white/80">
				Our maintenance solutions deliver measurable improvements to your solar system’s performance. See the real-world results our clients experience.
			</p>
			<p class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-sun">
				Performance improvement after professional maintenance, up to:
			</p>
			<dl class="mt-6 grid gap-4 sm:grid-cols-3">
				<div>
					<dt class="text-sm text-white/70">Commercial</dt>
					<dd class="text-4xl font-semibold">+27%</dd>
				</div>
				<div>
					<dt class="text-sm text-white/70">Residential</dt>
					<dd class="text-4xl font-semibold">+23%</dd>
				</div>
				<div>
					<dt class="text-sm text-white/70">Solar farms</dt>
					<dd class="text-4xl font-semibold">+22%</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">Satisfied customers</h2>
		<div class="mt-8">
			<Testimonials />
		</div>
	</section>

	<section class="border-t border-line">
		<div class="mx-auto grid max-w-5xl gap-8 px-5 py-16 md:grid-cols-[0.8fr_1.2fr]">
			<div>
				<h2 class="text-3xl font-semibold tracking-tight">Gallery</h2>
				<p class="mt-4 leading-7 text-muted">
					Solar panel cleaning services for residential and commercial properties.
				</p>
				<ul class="mt-4 list-disc space-y-2 pl-5 leading-7 text-muted">
					<li>Eco-friendly cleaning – 100% pure water, no chemicals</li>
					<li>Streak-free finish – HiFlo CarbonTec System (no marks or residue)</li>
					<li>Trusted experts – fully trained, licensed and insured technicians</li>
					<li>Professional and reliable – fast, friendly, and on time</li>
				</ul>
				<a href="/gallery" class="mt-6 inline-flex text-sm font-semibold text-accent">View the gallery</a>
			</div>
			<div class="grid grid-cols-2 gap-3">
				<Placeholder label="Gallery image placeholder" />
				<Placeholder label="Gallery image placeholder" />
				<Placeholder label="Gallery image placeholder" />
				<Placeholder label="Gallery image placeholder" />
			</div>
		</div>
	</section>

	<section class="border-t border-line bg-accent-soft">
		<div class="mx-auto grid max-w-5xl gap-10 px-5 py-16 md:grid-cols-[0.8fr_1.2fr]">
			<div>
				<h2 class="text-3xl font-semibold tracking-tight">Get a quote</h2>
				<p class="mt-4 leading-7 text-muted">
					Fill out the form below and we’ll get back to you within 24 hours with a customised quote.
				</p>
			</div>
			<QuoteForm />
		</div>
	</section>
</BaseLayout>
