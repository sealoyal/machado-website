---
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';
import { getServices } from '../lib/services';

const services = await getServices();
---

<BaseLayout title={site.name} description={site.description}>
	<section class="bg-navy text-white">
		<div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-16 md:grid-cols-[1.2fr_0.8fr] md:py-24">
			<div>
				<p class="text-sm font-semibold uppercase tracking-[0.14em] text-sun">
					{site.tagline}
				</p>
				<h1 class="mt-3 max-w-xl text-4xl font-semibold tracking-tight text-balance text-white md:text-6xl">
					Clean solar panels, ready to work
				</h1>
				<p class="mt-5 max-w-xl text-lg leading-8 text-white/80">
					Australian Solar Care cleans solar panels on homes and commercial sites. Dust, pollen, and grime come off the glass so the array is left clear.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="/contact"
						class="rounded-full bg-white px-5 py-3 text-sm font-semibold text-navy focus-visible:outline-white"
					>
						Request a clean
					</a>
					<a
						href="/services"
						class="rounded-full border border-white/40 px-5 py-3 text-sm font-semibold text-white focus-visible:outline-white"
					>
						See services
					</a>
				</div>
			</div>
			<div class="flex justify-center">
				<Image
					src={mark}
					alt=""
					width={160}
					height={172}
					layout="fixed"
					class="h-40 w-auto"
				/>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 pb-16">
		<div class="flex items-end justify-between gap-4">
			<h2 class="text-3xl font-semibold tracking-tight">Panel cleaning</h2>
			<a href="/services" class="text-sm font-semibold text-accent">All services</a>
		</div>
		<div class="mt-6 grid gap-4 md:grid-cols-2">
			{services.map((service) => <ServiceCard service={service} />)}
		</div>
	</section>

	<section class="border-t border-line bg-white">
		<div class="mx-auto grid max-w-5xl gap-8 px-5 py-16 md:grid-cols-3">
			<div>
				<h2 class="text-lg font-semibold">The glass</h2>
				<p class="mt-2 leading-6 text-muted">
					Each visit cleans the face of the panels, where dust and grime sit.
				</p>
			</div>
			<div>
				<h2 class="text-lg font-semibold">Homes and businesses</h2>
				<p class="mt-2 leading-6 text-muted">
					The same work covers a house array or a larger commercial site.
				</p>
			</div>
			<div>
				<h2 class="text-lg font-semibold">A tidy finish</h2>
				<p class="mt-2 leading-6 text-muted">
					Panels are rinsed and the array is left tidy when the clean is done.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
