---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
---

<BaseLayout
	title="Contact"
	description="Request a solar panel cleaning or bird proofing quote from Australian Solar Care in South Australia."
>
	<section class="mx-auto grid max-w-5xl gap-12 px-5 py-16 md:grid-cols-[0.8fr_1.2fr]">
		<div>
			<p class="kicker text-accent">Contact us – South Australia</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Get a quote</h1>
			<p class="mt-5 leading-7 text-muted">
				Fill out the form below and we’ll get back to you within 24 hours with a customised quote.
			</p>
			<dl class="mt-8 space-y-3 text-sm">
				<div>
					<dt class="sr-only">Phone</dt>
					<dd>
						<a href={site.phoneHref} class="flex items-center gap-3 rounded-2xl border border-line px-4 py-3">
							<span class="grid size-10 place-items-center rounded-full bg-accent-soft text-accent">
								<Icon name="phone" />
							</span>
							<span class="font-semibold text-ink">{site.phone}</span>
						</a>
					</dd>
				</div>
				<div>
					<dt class="sr-only">WhatsApp</dt>
					<dd>
						<a
							href={site.whatsappHref}
							class="flex items-center gap-3 rounded-2xl border border-line px-4 py-3"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="grid size-10 place-items-center rounded-full bg-[#25D366]/15 text-[#128C7E]">
								<Icon name="whatsapp" />
							</span>
							<span>
								<span class="block text-xs font-semibold uppercase tracking-wide text-muted">WhatsApp</span>
								<span class="font-semibold text-ink">{site.phone}</span>
							</span>
						</a>
					</dd>
				</div>
				<div>
					<dt class="sr-only">Email</dt>
					<dd>
						<a href={`mailto:${site.email}`} class="flex items-center gap-3 rounded-2xl border border-line px-4 py-3">
							<span class="grid size-10 place-items-center rounded-full bg-accent-soft text-accent">
								<Icon name="mail" />
							</span>
							<span class="font-semibold text-ink">{site.email}</span>
						</a>
					</dd>
				</div>
				<div class="flex items-center gap-3 rounded-2xl border border-line px-4 py-3">
					<span class="grid size-10 place-items-center rounded-full bg-panel text-navy">
						<Icon name="pin" />
					</span>
					<div>
						<dt class="text-xs font-semibold uppercase tracking-wide text-muted">Service area</dt>
						<dd class="font-semibold">{site.area}</dd>
					</div>
				</div>
			</dl>
		</div>
		<QuoteForm />
	</section>
</BaseLayout>
