---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
---

<BaseLayout
	title="Contact"
	description="Request a solar panel cleaning or bird proofing quote from Australian Solar Care in South Australia."
>
	<section class="mx-auto grid max-w-5xl gap-12 px-5 py-16 md:grid-cols-[0.8fr_1.2fr]">
		<div>
			<p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">Contact us – South Australia</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Get a quote</h1>
			<p class="mt-5 leading-7 text-muted">
				Fill out the form below and we’ll get back to you within 24 hours with a customised quote.
			</p>
			<dl class="mt-8 space-y-3 text-sm">
				<div>
					<dt class="font-semibold">Phone</dt>
					<dd><a href={site.phoneHref} class="text-accent">{site.phone}</a></dd>
				</div>
				<div>
					<dt class="font-semibold">Email</dt>
					<dd><a href={`mailto:${site.email}`} class="text-accent">{site.email}</a></dd>
				</div>
				<div>
					<dt class="font-semibold">Service area</dt>
					<dd class="text-muted">{site.area}</dd>
				</div>
			</dl>
		</div>
		<QuoteForm />
	</section>
</BaseLayout>
