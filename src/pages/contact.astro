---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
	title="Contact"
	description="Request a residential or commercial solar panel clean from Australian Solar Care."
>
	<section class="mx-auto grid max-w-5xl gap-12 px-5 py-16 md:grid-cols-[0.8fr_1.2fr]">
		<div>
			<p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">Contact</p>
			<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Request a clean</h1>
			<p class="mt-5 leading-7 text-muted">
				Tell us whether the panels are on a home or a commercial site. This form stays on your device and does not send a message yet.
			</p>
			<dl class="mt-8 space-y-2 text-sm">
				<div>
					<dt class="font-semibold">Phone</dt>
					<dd class="text-muted">{site.phone}</dd>
				</div>
				<div>
					<dt class="font-semibold">Email</dt>
					<dd class="text-muted">{site.email}</dd>
				</div>
				<div>
					<dt class="font-semibold">Service area</dt>
					<dd class="text-muted">{site.area}</dd>
				</div>
			</dl>
		</div>

		<div>
			<form id="enquiry" class="grid gap-4 rounded-2xl border border-line bg-white p-6" novalidate>
				<div>
					<label for="name" class="text-sm font-semibold">Name</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						autocomplete="name"
						class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2"
					/>
					<p class="field-error mt-1 hidden text-sm text-accent" data-for="name">Enter your name.</p>
				</div>
				<div>
					<label for="email" class="text-sm font-semibold">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						autocomplete="email"
						class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2"
					/>
					<p class="field-error mt-1 hidden text-sm text-accent" data-for="email">
						Enter a valid email address.
					</p>
				</div>
				<div>
					<label for="phone" class="text-sm font-semibold">Phone <span class="font-normal text-muted">(optional)</span></label>
					<input
						id="phone"
						name="phone"
						type="tel"
						autocomplete="tel"
						class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2"
					/>
				</div>
				<div>
					<label for="property" class="text-sm font-semibold">Property</label>
					<select
						id="property"
						name="property"
						required
						class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2"
					>
						<option value="">Select a property type</option>
						<option>Home</option>
						<option>Commercial site</option>
					</select>
					<p class="field-error mt-1 hidden text-sm text-accent" data-for="property">
						Select a property type.
					</p>
				</div>
				<div>
					<label for="message" class="text-sm font-semibold">Message</label>
					<textarea
						id="message"
						name="message"
						required
						rows="5"
						class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2"
					></textarea>
					<p class="field-error mt-1 hidden text-sm text-accent" data-for="message">
						Enter a message.
					</p>
				</div>
				<button type="submit" class="rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white">
					Submit enquiry
				</button>
			</form>
			<p id="enquiry-success" hidden class="rounded-2xl border border-line bg-panel p-6 leading-7">
				Thanks. This is a preview only, so the enquiry was not sent. Call {site.phone} or email {site.email} to reach Australian Solar Care.
			</p>
		</div>
	</section>
	<script>
	const form = document.querySelector('#enquiry');
	const success = document.querySelector('#enquiry-success');

	function showError(field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) {
		const message = form?.querySelector(`[data-for="${field.id}"]`);
		if (message instanceof HTMLElement) message.classList.remove('hidden');
		field.setAttribute('aria-invalid', 'true');
	}

	function clearError(field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) {
		const message = form?.querySelector(`[data-for="${field.id}"]`);
		if (message instanceof HTMLElement) message.classList.add('hidden');
		field.removeAttribute('aria-invalid');
	}

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement)) return;

		const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
			'input, textarea, select',
		);
		let valid = true;
		fields.forEach((field) => {
			clearError(field);
			if (!field.checkValidity()) {
				valid = false;
				showError(field);
			}
		});

		if (!valid || !(success instanceof HTMLElement)) return;
		form.hidden = true;
		success.hidden = false;
	});
	</script>
</BaseLayout>
