---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';
import { services } from '../../data/site';
---

<BaseLayout
	title="Services"
	description="Residential cleaning, commercial cleaning, bird proofing, and commercial operations and maintenance."
>
	<section class="mx-auto max-w-5xl px-5 py-16">
		<p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">Our services</p>
		<h1 class="mt-3 max-w-2xl text-4xl font-semibold tracking-tight md:text-5xl">
			Solar panel cleaning and bird proofing
		</h1>
		<div class="mt-10 grid gap-4 md:grid-cols-2">
			{
				services.map((service) => (
					<article class="flex h-full flex-col rounded-2xl border border-line p-6">
						<Placeholder label={`${service.title} image placeholder`} />
						<h2 class="mt-5 text-2xl font-semibold">
							<a href={service.href}>{service.title}</a>
						</h2>
						<p class="mt-3 flex-1 leading-7 text-muted">{service.summary}</p>
						<a href={service.href} class="mt-5 text-sm font-semibold text-accent">Learn more</a>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
