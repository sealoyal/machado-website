---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../data/site';
---

<BaseLayout
	title="Services"
	description="Residential cleaning, commercial cleaning, bird proofing, and commercial operations and maintenance."
>
	<section class="mx-auto max-w-5xl px-5 py-16 md:py-20">
		<p class="kicker text-accent">Our services</p>
		<h1 class="mt-3 max-w-2xl text-4xl font-semibold tracking-tight md:text-5xl">
			Solar panel cleaning and bird proofing
		</h1>
		<div class="mt-10 grid gap-4 md:grid-cols-2">
			{services.map((service) => <ServiceCard {...service} heading="h2" />)}
		</div>
	</section>
</BaseLayout>
