---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServices } from '../../lib/services';

export async function getStaticPaths() {
	const services = await getServices();
	return services.map((service) => ({
		params: { slug: service.id },
		props: { service },
	}));
}

interface Props {
	service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<BaseLayout title={service.data.title} description={service.data.description}>
	<article class="mx-auto max-w-3xl px-5 py-16">
		<p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">
			{service.data.audience}
		</p>
		<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
			{service.data.title}
		</h1>
		<p class="mt-5 text-lg leading-8 text-muted">{service.data.summary}</p>
		<div class="content mt-8">
			<Content />
		</div>
		<a
			href="/contact"
			class="mt-4 inline-flex rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white"
		>
			Request this clean
		</a>
	</article>
</BaseLayout>
