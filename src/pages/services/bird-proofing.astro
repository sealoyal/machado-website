---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';
import QuoteForm from '../../components/QuoteForm.astro';

const faqs = [
	{
		question: 'How much does solar panel bird proofing cost in Adelaide?',
		answer:
			'The cost of solar bird proofing in Adelaide depends on the number of panels, roof type, and accessibility. We provide free on-site assessments with upfront pricing and no hidden costs. Most residential installations are very affordable and completed in a few hours.',
	},
	{
		question: 'What type of mesh do you use for solar panel bird proofing?',
		answer:
			'We use marine-grade stainless steel solar mesh that is UV resistant, corrosion-proof, and built to last over 10 years. The mesh is fixed securely around the full perimeter of your solar panels without drilling into the panels or voiding your warranty.',
	},
	{
		question: 'Will bird proofing mesh affect my solar panel performance?',
		answer:
			'No. Our solar mesh installation is designed to maintain full airflow and water drainage beneath your panels. In fact, removing bird debris and droppings often improves panel efficiency after installation.',
	},
	{
		question: 'Do you remove pigeons and nests before installing mesh?',
		answer:
			'Yes. Every installation includes a thorough clean-up. We carefully remove all pigeon nests, droppings, and debris from under your solar panels before fitting the stainless steel mesh barrier.',
	},
	{
		question: 'Do you service areas outside Adelaide in South Australia?',
		answer:
			'Absolutely. While we’re based in Adelaide, we service the Adelaide Hills, Barossa Valley, Fleurieu Peninsula, and surrounding regions across South Australia. Contact us for availability in your area.',
	},
	{
		question: 'Is your solar bird proofing installation warranty-safe?',
		answer:
			'Yes. Our installers are trained solar technicians who use clip-on attachment methods that do not drill into your panels or roof. Your solar panel warranty remains fully intact after our installation.',
	},
];
---

<BaseLayout
	title="Bird proofing"
	description="Solar panel bird proofing in Adelaide and South Australia. Stainless steel mesh that keeps pigeons out without voiding the panel warranty."
>
	<section class="bg-navy text-white">
		<div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-16 md:grid-cols-2">
			<div>
				<p class="text-sm font-semibold text-sun">$20M public liability insured</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
					Solar bird proofing Adelaide and South Australia
				</h1>
				<p class="mt-4 text-lg leading-8 text-white/80">
					Stop pigeons nesting under your solar panels with professional solar panel mesh installation. We remove birds, clean debris, and install stainless steel solar mesh that keeps them out permanently.
				</p>
			</div>
			<Placeholder label="Bird proofing image placeholder" />
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">Birds under your solar panels? Here’s the damage they cause</h2>
		<p class="mt-4 leading-7 text-muted">
			The gap between your solar panels and roof is the perfect nesting spot for pigeons. Left unchecked, birds under solar panels cause costly damage that worsens every season.
		</p>
		<ul class="mt-6 space-y-4 leading-7 text-muted">
			<li><strong class="text-ink">Constant noise.</strong> Cooing and scratching sounds throughout the day disturbing your peace at home.</li>
			<li><strong class="text-ink">Blocked drainage.</strong> Nesting materials clog gutters and cause water damage.</li>
			<li><strong class="text-ink">Health hazards.</strong> Pigeon droppings carry diseases and create unsanitary conditions on your roof and gutters.</li>
			<li><strong class="text-ink">System damage.</strong> Debris and droppings corrode wiring and reduce solar panel efficiency over time.</li>
		</ul>
	</section>

	<section class="border-t border-line bg-accent-soft">
		<div class="mx-auto max-w-3xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">Stainless steel solar mesh installation</h2>
			<p class="mt-4 leading-7 text-muted">
				Australian Solar Care provides approved, warranty-safe bird proofing to prevent birds and animals from nesting under your solar panels. Our humane, chemical-free barriers protect your system from noise, damage, fire risks, and debris while maintaining full manufacturer warranty compliance.
			</p>
			<p class="mt-4 leading-7 text-muted">
				Our solar panel mesh system creates a complete barrier around your panels, permanently preventing pigeons from accessing the space underneath. This solar skirt installation maintains your system’s performance while keeping birds out for good.
			</p>
			<ul class="mt-4 list-disc space-y-2 pl-5 leading-7 text-muted">
				<li>Marine-grade stainless steel solar mesh</li>
				<li>Allows natural airflow and water drainage</li>
				<li>UV resistant and long-lasting</li>
				<li>Warranty safe</li>
				<li>Stops birds, possums and debris permanently</li>
				<li>Virtually invisible from ground level</li>
			</ul>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">Solar bird proofing before and after</h2>
		<p class="mt-4 leading-7 text-muted">
			See the difference our solar panel bird proofing makes across Adelaide and South Australia. Every installation delivers a clean, professional finish.
		</p>
		<div class="mt-8 grid gap-4 sm:grid-cols-2">
			<Placeholder label="Residential system – Adelaide" />
			<Placeholder label="Residential roof – regional SA" />
			<Placeholder label="120kW warehouse system – Adelaide" />
			<Placeholder label="2.5MW solar system – regional SA" />
		</div>
	</section>

	<section class="border-t border-line bg-navy text-white">
		<div class="mx-auto max-w-5xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">Adelaide’s trusted solar bird proofing specialists</h2>
			<p class="mt-4 max-w-3xl leading-7 text-white/80">
				We’re not general handymen or pest controllers. We specialise exclusively in solar panel bird proofing across Adelaide and South Australia.
			</p>
			<dl class="mt-8 grid gap-6 sm:grid-cols-4">
				<div>
					<dt class="text-sm text-white/70">Metres installed</dt>
					<dd class="text-3xl font-semibold">1000+</dd>
				</div>
				<div>
					<dt class="text-sm text-white/70">Insurance cover</dt>
					<dd class="text-3xl font-semibold">$20M</dd>
				</div>
				<div>
					<dt class="text-sm text-white/70">Star rating</dt>
					<dd class="text-3xl font-semibold">5.0</dd>
				</div>
				<div>
					<dt class="text-sm text-white/70">Warranty safe</dt>
					<dd class="text-3xl font-semibold">100%</dd>
				</div>
			</dl>
			<ul class="mt-8 grid gap-4 md:grid-cols-3">
				<li>
					<h3 class="font-semibold">Solar system health check</h3>
					<p class="mt-2 text-white/80">Every installation includes a thorough visual inspection of your solar array. We check for visible damage, debris buildup, and potential issues — all without touching any electrical components.</p>
				</li>
				<li>
					<h3 class="font-semibold">Fully insured solar technicians</h3>
					<p class="mt-2 text-white/80">We carry $20 million in public liability insurance. Our work is covered, our team is covered, and your property is protected.</p>
				</li>
				<li>
					<h3 class="font-semibold">Specialist bird proofing installers</h3>
					<p class="mt-2 text-white/80">Our installers are trained specifically in solar panel bird proofing and mesh installation. They understand the systems they work around and take every precaution to protect your investment.</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">How solar panel bird proofing works</h2>
		<ol class="mt-8 space-y-6">
			<li>
				<h3 class="font-semibold">1. Free on-site assessment</h3>
				<p class="mt-2 leading-7 text-muted">We inspect your solar system, measure your array, and provide a clear, upfront quote with no hidden costs. Available across Adelaide and regional SA.</p>
			</li>
			<li>
				<h3 class="font-semibold">2. Pigeon nest removal and clean</h3>
				<p class="mt-2 leading-7 text-muted">If pigeons have already nested, we carefully remove nesting materials and clean the area beneath your panels to restore hygiene.</p>
			</li>
			<li>
				<h3 class="font-semibold">3. Solar mesh installation</h3>
				<p class="mt-2 leading-7 text-muted">Our technicians install premium stainless steel solar mesh around the full perimeter of your solar array, creating a permanent bird-proof barrier.</p>
			</li>
			<li>
				<h3 class="font-semibold">4. Final inspection and photos</h3>
				<p class="mt-2 leading-7 text-muted">We complete a final quality check and provide before and after photos for your records, ensuring a warranty-safe finish.</p>
			</li>
		</ol>
	</section>

	<section class="border-t border-line">
		<div class="mx-auto grid max-w-5xl gap-8 px-5 py-16 md:grid-cols-2">
			<article>
				<h2 class="text-2xl font-semibold">Residential solar panel bird proofing</h2>
				<p class="mt-3 leading-7 text-muted">
					Protect your home’s solar investment with professional pigeon proofing. We work with all roof types — tile, metal, and flat — across Adelaide and South Australia. Most residential solar mesh installations are completed in just a few hours.
				</p>
				<ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
					<li>Single-storey and multi-storey homes</li>
					<li>All panel brands and configurations</li>
					<li>Same-day service available in Adelaide</li>
				</ul>
			</article>
			<article>
				<h2 class="text-2xl font-semibold">Commercial solar bird proofing</h2>
				<p class="mt-3 leading-7 text-muted">
					Large-scale commercial solar bird proofing for warehouses, office buildings, shopping centres, and strata complexes across South Australia. We provide detailed quotes, work with body corporates, and coordinate multi-building projects.
				</p>
				<ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
					<li>Large commercial arrays</li>
					<li>Strata and body corporate projects</li>
					<li>Detailed reporting and compliance</li>
				</ul>
			</article>
		</div>
	</section>

	<section class="border-t border-line bg-accent-soft">
		<div class="mx-auto max-w-3xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">Solar bird proofing FAQs</h2>
			<div class="mt-6 space-y-3">
				{
					faqs.map((item) => (
						<details class="rounded-2xl border border-line bg-white px-5 py-4">
							<summary class="cursor-pointer font-semibold">{item.question}</summary>
							<p class="mt-3 leading-7 text-muted">{item.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto grid max-w-5xl gap-10 px-5 py-16 md:grid-cols-[0.8fr_1.2fr]">
		<div>
			<h2 class="text-3xl font-semibold tracking-tight">Get your free solar bird proofing quote in Adelaide</h2>
			<p class="mt-4 leading-7 text-muted">
				The longer pigeons nest under your solar panels, the more damage they cause. Request your free assessment today and protect your solar investment before the problem gets worse.
			</p>
		</div>
		<QuoteForm />
	</section>
</BaseLayout>
