---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Testimonials from '../../components/Testimonials.astro';
---

<BaseLayout
	title="Residential systems"
	description="Professional solar panel cleaning that keeps home systems running efficiently across Adelaide and regional areas."
>
	<section class="bg-navy text-white">
		<div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-16 md:grid-cols-2">
			<div>
				<p class="text-sm font-semibold text-sun">10+ years of experience</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
					Protect your home and your solar investment
				</h1>
				<p class="mt-4 text-lg leading-8 text-white/80">
					Professional solar panel cleaning that keeps your system running efficiently and looking its best.
				</p>
			</div>
			<Placeholder label="Residential cleaning image placeholder" />
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">Why dirty solar panels are a problem at home</h2>
		<p class="mt-4 leading-7 text-muted">
			Your solar panels work hard every day, but they can’t clean themselves. Here’s why regular cleaning matters:
		</p>
		<ul class="mt-4 list-disc space-y-2 pl-5 leading-7 text-muted">
			<li>Dirt, dust, pollen, salt, and pollution build up over time</li>
			<li>Panels are out of sight on your roof, so issues often go unnoticed</li>
			<li>Dirty panels can reduce efficiency and your peace of mind</li>
			<li>Regular cleaning helps maintain your solar investment</li>
		</ul>
	</section>

	<section class="border-t border-line bg-accent-soft">
		<div class="mx-auto max-w-3xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">More than just cleaning – caring for your solar system</h2>
			<p class="mt-4 leading-7 text-muted">
				Australian Solar Care delivers professional solar panel cleaning and maintenance across Adelaide and regional areas. Our trained technicians use advanced purified-water systems and provide a detailed observation report with every service, ensuring safety, performance, and warranty protection for your solar investment.
			</p>
			<p class="mt-4 leading-7 text-muted">When we clean your panels, we also take the time to look after your system:</p>
			<ul class="mt-4 list-disc space-y-2 pl-5 leading-7 text-muted">
				<li>Visual checks during every clean</li>
				<li>We inspect your panels as we work</li>
				<li>We look for nesting, debris, or visible damage</li>
				<li>Identifying potential issues early</li>
				<li>You’ll know what’s happening on your roof</li>
				<li>No surprises, just clear information</li>
			</ul>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">Before and after – see the difference</h2>
		<p class="mt-4 leading-7 text-muted">
			Our professional cleaning transforms dirty, underperforming panels back to their best.
		</p>
		<div class="mt-8 grid gap-4 sm:grid-cols-2">
			<Placeholder label="Before: months of dust and grime" />
			<Placeholder label="After: crystal clear and working efficiently" />
		</div>
	</section>

	<section class="border-t border-line">
		<div class="mx-auto max-w-5xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">Our equipment and gentle cleaning methods</h2>
			<p class="mt-4 leading-7 text-muted">
				We use professional-grade equipment designed specifically for solar panel cleaning.
			</p>
			<ul class="mt-8 grid gap-4 sm:grid-cols-2">
				<li class="rounded-2xl border border-line p-6">
					<h3 class="font-semibold">Soft brush</h3>
					<p class="mt-2 text-muted">No harsh chemicals, just pure filtered water.</p>
				</li>
				<li class="rounded-2xl border border-line p-6">
					<h3 class="font-semibold">No pressure washing</h3>
					<p class="mt-2 text-muted">Gentle cleaning with no risk of damage.</p>
				</li>
				<li class="rounded-2xl border border-line p-6">
					<h3 class="font-semibold">Panel-safe system</h3>
					<p class="mt-2 text-muted">Non-abrasive water-fed pole technology.</p>
				</li>
				<li class="rounded-2xl border border-line p-6">
					<h3 class="font-semibold">Designed for residential</h3>
					<p class="mt-2 text-muted">Specifically for home solar panels.</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="border-t border-line bg-navy text-white">
		<div class="mx-auto max-w-5xl px-5 py-16">
			<h2 class="text-3xl font-semibold tracking-tight">Safe, insured and professional</h2>
			<p class="mt-4 text-white/80">Your peace of mind matters to us. Here’s why you can trust our team.</p>
			<ul class="mt-8 grid gap-4 sm:grid-cols-2">
				<li>
					<h3 class="font-semibold">Fully insured</h3>
					<p class="mt-2 text-white/80">$20M public liability coverage.</p>
				</li>
				<li>
					<h3 class="font-semibold">10+ years experience</h3>
					<p class="mt-2 text-white/80">Trusted by Adelaide homeowners.</p>
				</li>
				<li>
					<h3 class="font-semibold">Trained professionals</h3>
					<p class="mt-2 text-white/80">Licensed, experienced technicians.</p>
				</li>
				<li>
					<h3 class="font-semibold">Respectful service</h3>
					<p class="mt-2 text-white/80">We care for your home and property.</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 py-16">
		<h2 class="text-3xl font-semibold tracking-tight">What our customers say</h2>
		<p class="mt-4 text-muted">Don’t just take our word for it – hear from Adelaide homeowners who trust us.</p>
		<div class="mt-8">
			<Testimonials />
		</div>
	</section>

	<section class="border-t border-line bg-accent-soft">
		<div class="mx-auto grid max-w-5xl gap-10 px-5 py-16 md:grid-cols-[0.8fr_1.2fr]">
			<div>
				<h2 class="text-3xl font-semibold tracking-tight">Get your free quote</h2>
				<p class="mt-4 leading-7 text-muted">
					Fill in your details below and we’ll get back to you with a fair quote.
				</p>
			</div>
			<QuoteForm />
		</div>
	</section>
</BaseLayout>
