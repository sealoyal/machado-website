---
import { nav, site } from '../data/site';
---

<footer class="mt-auto bg-navy text-white">
	<div class="mx-auto grid max-w-5xl gap-8 px-5 py-10 sm:grid-cols-2">
		<div>
			<p class="font-semibold">{site.name}</p>
			<p class="mt-2 max-w-sm text-sm leading-6 text-white/80">{site.tagline}</p>
		</div>
		<div class="text-sm leading-6">
			<p>Phone: {site.phone}</p>
			<p>Email: {site.email}</p>
			<p>Service area: {site.area}</p>
			<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
				{
					nav.map((item) => (
						<li>
							<a href={item.href} class="font-semibold text-white">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>
