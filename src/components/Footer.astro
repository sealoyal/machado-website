---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
---

<footer class="mt-auto bg-navy text-white">
	<div class="mx-auto grid max-w-5xl gap-8 px-5 py-10 sm:grid-cols-2">
		<div>
			<p class="font-semibold">{site.name}</p>
			<p class="mt-2 max-w-sm text-sm leading-6 text-white/80">{site.tagline}</p>
		</div>
		<div class="text-sm leading-6">
			<p>
				<a href={site.phoneHref} class="inline-flex items-center gap-2 font-semibold text-white">
					<Icon name="phone" />
					{site.phone}
				</a>
			</p>
			<p>
				<a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 font-semibold text-white">
					<Icon name="mail" />
					{site.email}
				</a>
			</p>
			<p>{site.area}</p>
			<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
				{
					nav.map((item) => (
						<li>
							<a href={item.href} class="font-semibold text-white">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<p class="mt-6 text-white/70">Australian Solar Care Pty Ltd © 2014–2025</p>
		</div>
	</div>
</footer>
