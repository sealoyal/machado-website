---
import { services, site } from '../data/site';
---

<form id="enquiry" class="grid gap-4 rounded-2xl border border-line bg-white p-6" novalidate>
	<p class="text-sm text-muted">
		Fill out the form below and we’ll get back to you within 24 hours with a customised quote. This preview does not send the form yet.
	</p>
	<div>
		<label for="name" class="text-sm font-semibold">Name</label>
		<input id="name" name="name" type="text" required autocomplete="name" class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2" />
		<p class="field-error mt-1 hidden text-sm text-accent" data-for="name">Enter your name.</p>
	</div>
	<div>
		<label for="email" class="text-sm font-semibold">Email</label>
		<input id="email" name="email" type="email" required autocomplete="email" class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2" />
		<p class="field-error mt-1 hidden text-sm text-accent" data-for="email">Enter a valid email address.</p>
	</div>
	<div>
		<label for="phone" class="text-sm font-semibold">Phone</label>
		<input id="phone" name="phone" type="tel" required autocomplete="tel" class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2" />
		<p class="field-error mt-1 hidden text-sm text-accent" data-for="phone">Enter your phone number.</p>
	</div>
	<div>
		<label for="address" class="text-sm font-semibold">Address</label>
		<input id="address" name="address" type="text" required autocomplete="street-address" class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2" />
		<p class="field-error mt-1 hidden text-sm text-accent" data-for="address">Enter your address.</p>
	</div>
	<div>
		<label for="service" class="text-sm font-semibold">Services</label>
		<select id="service" name="service" required class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2">
			<option value="">Select a service</option>
			{services.map((service) => <option>{service.title}</option>)}
		</select>
		<p class="field-error mt-1 hidden text-sm text-accent" data-for="service">Select a service.</p>
	</div>
	<div>
		<label for="panels" class="text-sm font-semibold">Number of solar panels</label>
		<input id="panels" name="panels" type="text" required inputmode="numeric" class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2" />
		<p class="field-error mt-1 hidden text-sm text-accent" data-for="panels">Enter the number of solar panels.</p>
	</div>
	<div>
		<label for="comments" class="text-sm font-semibold">Comments / special instructions</label>
		<textarea id="comments" name="comments" required rows="5" class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2"></textarea>
		<p class="field-error mt-1 hidden text-sm text-accent" data-for="comments">Enter your comments.</p>
	</div>
	<button type="submit" class="rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white">
		Get a quote
	</button>
</form>
<p id="enquiry-success" hidden class="rounded-2xl border border-line bg-panel p-6 leading-7">
	Thanks. This is a preview only, so the quote request was not sent. Call {site.phone} or email {site.email}.
</p>

<script>
	const form = document.querySelector('#enquiry');
	const success = document.querySelector('#enquiry-success');

	function fieldOf(id: string) {
		return form?.querySelector(`[data-for="${id}"]`);
	}

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement)) return;

		const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
			'input, textarea, select',
		);
		let valid = true;
		fields.forEach((field) => {
			const message = fieldOf(field.id);
			if (message instanceof HTMLElement) message.classList.add('hidden');
			field.removeAttribute('aria-invalid');
			if (!field.checkValidity()) {
				valid = false;
				if (message instanceof HTMLElement) message.classList.remove('hidden');
				field.setAttribute('aria-invalid', 'true');
			}
		});

		if (!valid || !(success instanceof HTMLElement)) return;
		form.hidden = true;
		success.hidden = false;
	});
</script>
