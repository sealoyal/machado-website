---
import Icon from './Icon.astro';
import { testimonials } from '../data/site';
---

<ul class="grid gap-4 md:grid-cols-3">
	{
		testimonials.map((item) => (
			<li class="flex flex-col rounded-2xl border border-line bg-white p-6">
				<Icon name="quote" class="size-6 text-accent" />
				<p class="mt-4 flex-1 leading-7 text-muted">“{item.quote}”</p>
				<p class="mt-5 border-t border-line pt-4 text-sm font-semibold">{item.name}</p>
			</li>
		))
	}
</ul>
