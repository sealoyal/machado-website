---
interface Props {
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
const hasBackground = className?.includes('bg-');
---

<div
	class:list={[
		'relative flex min-h-44 items-center justify-center overflow-hidden rounded-2xl px-4 py-8 text-center text-sm',
		hasBackground ? undefined : 'bg-accent-soft text-muted',
		className,
	]}
	role="img"
	aria-label={label}
>
	<span
		class="pointer-events-none absolute inset-0 opacity-[0.14]"
		style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px); background-size: 28px 28px;"
		aria-hidden="true"
	></span>
	<span class="relative max-w-[16rem]">{label}</span>
</div>
