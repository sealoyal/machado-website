---
interface Props {
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
---

<div
	class:list={[
		'flex min-h-44 items-center justify-center rounded-2xl border border-dashed border-line bg-accent-soft px-4 py-8 text-center text-sm text-muted',
		className,
	]}
	role="img"
	aria-label={label}
>
	{label}
</div>
