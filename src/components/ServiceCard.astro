---
import type { CollectionEntry } from 'astro:content';

interface Props {
	service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-line bg-white p-6">
	<p class="text-sm font-semibold text-accent">{service.data.audience}</p>
	<h2 class="mt-2 text-2xl font-semibold tracking-tight">
		<a href={`/services/${service.id}`} class="text-ink">
			{service.data.title}
		</a>
	</h2>
	<p class="mt-3 flex-1 leading-6 text-muted">{service.data.summary}</p>
	<a href={`/services/${service.id}`} class="mt-5 text-sm font-semibold text-accent">
		View this service
	</a>
</article>
