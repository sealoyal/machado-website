---
import Icon from './Icon.astro';

interface Props {
	href: string;
	title: string;
	summary: string;
	icon: 'home' | 'building' | 'bird' | 'wrench';
	heading?: 'h2' | 'h3';
}

const { href, title, summary, icon, heading = 'h3' } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-line bg-white p-6">
	<span class="grid size-11 place-items-center rounded-2xl bg-panel text-navy">
		<Icon name={icon} class="size-5" />
	</span>
	{
		heading === 'h2' ? (
			<h2 class="mt-5 text-2xl font-semibold tracking-tight">
				<a href={href}>{title}</a>
			</h2>
		) : (
			<h3 class="mt-5 text-2xl font-semibold tracking-tight">
				<a href={href}>{title}</a>
			</h3>
		)
	}
	<p class="mt-3 flex-1 leading-7 text-muted">{summary}</p>
	<a href={href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
		Learn more
		<Icon name="arrow" class="size-4" />
	</a>
</article>
